@model Product

<h2>Create Product</h2>

<form method="post">
    <label>Name</label>
    <input class="form-control" name="Name" />

    <label>Price</label>
    <input class="form-control" name="Price" />

    <label>Category</label>
    <input class="form-control" name="Category" />

    <br />
    <button class="btn btn-success">Save</button>
</form>