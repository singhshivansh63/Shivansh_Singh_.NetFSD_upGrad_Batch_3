@model ContactApp.Models.ContactInfo

<h2>Add New Contact</h2>

<form method="post">
    <div class="form-group">
        <label>Contact ID:</label>
        <input type="number" asp-for="ContactId" class="form-control" required />
    </div>

    <div class="form-group">
        <label>First Name:</label>
        <input type="text" asp-for="FirstName" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Last Name:</label>
        <input type="text" asp-for="LastName" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Company Name:</label>
        <input type="text" asp-for="CompanyName" class="form-control" />
    </div>

    <div class="form-group">
        <label>Email ID:</label>
        <input type="email" asp-for="EmailId" class="form-control" />
    </div>

    <div class="form-group">
        <label>Mobile No:</label>
        <input type="number" asp-for="MobileNo" class="form-control" />
    </div>

    <div class="form-group">
        <label>Designation:</label>
        <input type="text" asp-for="Designation" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary mt-3">Save</button>
</form>