@model IEnumerable<MovieApp.Models.Movie>

<h2>Movie List</h2>

<p>
    <a class="btn btn-primary" href="/Movies/Create">Add New Movie</a>
</p>

<table class="table table-bordered mt-3">
    <tr>
        <th>Title</th>
        <th>Genre</th>
        <th>Release Date</th>
        <th>Price</th>
        <th>Rating</th>
        <th>Action</th>
    </tr>

    @foreach (var movie in Model)
    {
        <tr>
            <td>@movie.Title</td>
            <td>@movie.Genre</td>
            <td>@movie.ReleaseDate.ToShortDateString()</td>
            <td>@movie.Price</td>
            <td>@movie.Rating</td>
            <td>
                <a href="/Movies/Details/@movie.Id">Details</a> |
                <a href="/Movies/Edit/@movie.Id">Edit</a> |
                <a href="/Movies/Delete/@movie.Id">Delete</a>
            </td>
        </tr>
    }
</table>