@model IEnumerable<WebApplication10.Models.Course>

<h2>Course List</h2>

<a class="btn btn-primary" href="/Course/Create">Add New Course</a>
<br />
<br />

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Course ID</th>
            <th>Course Name</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.CourseId</td>
                <td>@c.CourseName</td>
            </tr>
        }
    </tbody>
</table>